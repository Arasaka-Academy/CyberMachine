# Keep checksum-covered text consistent across platforms.
* text eol=lf

# Preserve native CAD and CSV bytes, including their original line endings.
*.stp -text
*.step -text
*.csv -text

# Compressed projects and visual reference files are binary artifacts.
*.3mf binary
*.zip binary
*.png binary
*.pdf binary
*.glb binary
*.gz binary
*.mp4 binary

# Generated bundles retain upstream shader and license text spacing.
docs/assembly/r2/index.html -whitespace
docs/assembly/r2/assets/third-party-licenses.txt -whitespace
